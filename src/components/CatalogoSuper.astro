---
// Catálogo del Súper (HTML puro, 0 KB de JS): buscador, pasillos y productos con precio en $ y Bs.
// Lo usa la vista previa del admin (10A) y luego /super (10B, con carrito).
// Nunca recibe costos ni márgenes: solo el precio final que viene de la base.
import Icono from "./Icono.astro";
import { mostrarPrecio } from "@/lib/precio.js";
import { precioBs, textoTasa, CREDITO_FOTOS } from "@/lib/super.js";

/**
 * productos: [{ id, nombre, marca, presentacion, foto_url, precio }]
 * pasillos: [{ id, nombre, slug }]   actual: slug o null   q: texto buscado
 * base: ruta de esta página (ej. "/super")   tasa: { bs, fecha }   envio: { zona, gratis_desde }
 * carrito: true = botones "Agregar" y barra "Ver pedido" (carrito guardado en el teléfono, ~1,3 KB en línea).
 */
const { productos = [], pasillos = [], actual = null, q = "", base = "/super", tasa = null, envio = null, carrito = false } = Astro.props;
const enlace = (slug) => (slug ? `${base}?pasillo=${slug}` : base);
const tieneFotoOff = productos.some((p) => p.foto_url?.startsWith("/super/fotos/"));
const tasaTxt = textoTasa(tasa);
---
{envio && (
  <p class="tarjeta aviso-envio">
    <strong>🛵 Envío gratis desde {mostrarPrecio(envio.gratis_desde)}</strong> en el {envio.zona ? envio.zona[0].toLowerCase() + envio.zona.slice(1) : "casco central"}.
    <span class="texto-2">Otras zonas: te confirmamos el envío por WhatsApp.</span>
  </p>
)}

<form action={base} role="search" style="margin-top:14px">
  <div class="tarjeta fila" style="padding:0 12px">
    <Icono nombre="buscar" tam={20} class="texto-2" />
    <input name="q" type="search" class="campo-limpio" value={q} placeholder="Harina, arroz, queso…" maxlength="60" enterkeyhint="search" aria-label="Buscar en el Súper" />
    <button type="submit" class="boton-texto">Buscar</button>
  </div>
</form>

<ul class="chips" aria-label="Pasillos">
  {pasillos.map((s) => (
    <li><a href={enlace(s.slug)} class="chip" aria-current={actual === s.slug && !q ? "true" : undefined}>{s.nombre}</a></li>
  ))}
</ul>

{q && <p class="texto-2" style="margin:14px 0 0">{productos.length ? `${productos.length} resultado${productos.length === 1 ? "" : "s"} para "${q}"` : `No encontramos "${q}" en el Súper.`} <a href={base}>Ver todo</a></p>}

{productos.length > 0 ? (
  <ul class="rejilla-productos">
    {productos.map((p) => {
      const bs = precioBs(p.precio, tasa);
      return (
        <li>
          <div class="tarjeta producto producto-super">
            {p.foto_url ? <img src={p.foto_url} alt="" width="240" height="240" loading="lazy" decoding="async" />
              : <span class="foto-vacia foto-pasillo" aria-hidden="true"><Icono nombre="super" tam={44} /></span>}
            <span class="nombre-producto">{p.nombre}</span>
            {(p.marca || p.presentacion) && <span class="detalle-producto texto-2">{[p.marca, p.presentacion].filter(Boolean).join(" · ")}</span>}
            <span class="precio-producto">{mostrarPrecio(p.precio)}{bs !== null && <span class="precio-bs texto-2"> · {mostrarPrecio(bs, "VES")}</span>}</span>
            {carrito && (
              <div class="control-carrito" data-id={p.id} data-p={p.precio} data-n="0">
                <button type="button" class="boton boton-agregar" data-agregar>Agregar</button>
                <span class="paso-carrito">
                  <button type="button" data-menos aria-label={`Quitar un ${p.nombre}`}>−</button>
                  <span class="cuantos" aria-live="polite">0</span>
                  <button type="button" data-mas aria-label={`Agregar otro ${p.nombre}`}>+</button>
                </span>
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ul>
) : !q && <p class="texto-2" style="margin-top:18px">Todavía no hay productos en este pasillo.</p>}

<p class="texto-2 pie-super">
  {tasaTxt && <>{tasaTxt}.<br /></>}
  {tieneFotoOff && CREDITO_FOTOS}
</p>

{carrito && (
  <>
    <a id="barra-carrito" class="barra-carrito" href="/super/pedido" hidden>
      <span data-resumen></span><strong>Ver pedido ›</strong>
    </a>
    <script is:inline>
      (() => {
        const K = "lokl_carrito";
        let c = {};
        try { c = JSON.parse(localStorage.getItem(K)) || {}; } catch {}
        const guardar = () => { try { localStorage.setItem(K, JSON.stringify(c)); } catch {} };
        const barra = document.getElementById("barra-carrito");
        const plata = (n) => "$" + n.toFixed(2).replace(".", ",").replace(",00", "");
        function pintar() {
          document.querySelectorAll(".control-carrito").forEach((caja) => {
            const n = c[caja.dataset.id]?.c || 0;
            caja.dataset.n = n;
            caja.querySelector(".cuantos").textContent = n;
          });
          let n = 0, t = 0;
          const partes = [];
          for (const [id, v] of Object.entries(c)) { n += v.c; t += v.c * v.p; partes.push(id + "x" + v.c); }
          barra.hidden = !n;
          barra.querySelector("[data-resumen]").textContent = n + (n === 1 ? " producto · " : " productos · ") + plata(t);
          barra.href = "/super/pedido?c=" + partes.join(".");
        }
        document.addEventListener("click", (e) => {
          const b = e.target.closest("[data-agregar],[data-mas],[data-menos]");
          if (!b) return;
          const caja = b.closest(".control-carrito");
          const id = caja.dataset.id;
          const v = c[id] || { c: 0 };
          v.p = Number(caja.dataset.p);
          v.c = b.hasAttribute("data-menos") ? v.c - 1 : Math.min(v.c + 1, 50);
          if (v.c <= 0) delete c[id]; else c[id] = v;
          guardar();
          pintar();
        });
        addEventListener("pageshow", () => { try { c = JSON.parse(localStorage.getItem(K)) || {}; } catch {} pintar(); });
        pintar();
      })();
    </script>
  </>
)}
