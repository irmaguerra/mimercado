---
// Cabecera: logo + "📍 San Fernando ▾" para cambiar de ubicación en cualquier momento.
import Logo from "./Logo.astro";
import Icono from "./Icono.astro";

const { lugar, volver = true } = Astro.props; // lugar: ej. "San Fernando"; vacío = "Elegir ubicación"
// "‹ Volver" en todas las páginas menos la portada: regresa a la página anterior de Lokl; si la persona
// llegó de afuera (WhatsApp, la app instalada) o no hay JavaScript, la lleva al inicio.
---
<header class="fila-entre" style="padding-top:16px">
  <a href="/" aria-label="Lokl, inicio" style="color:var(--texto)"><Logo alto={34} /></a>
  <span class="fila" style="gap:6px">
    <a href="/favoritos" class="chip-ubicacion boton-favoritos" aria-label="Mis favoritos" title="Mis favoritos"><Icono nombre="favorito" tam={20} /></a>
    <a href="/ubicacion" class="chip-ubicacion">
      <Icono nombre="ubicacion" tam={18} />
      <span>{lugar || "Elegir ubicación"}</span>
      <span aria-hidden="true">▾</span>
    </a>
  </span>
</header>
{volver && (
  <a href="/" class="volver" onclick="if(document.referrer.indexOf(location.origin)===0&&history.length>1){history.back();return false}">‹ Volver</a>
)}
