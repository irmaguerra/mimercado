---
// Página pública de una tienda, ficha de servicio o vendedor de clasificados. HTML puro.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import Icono from "@/components/Icono.astro";
import { estaAbiertoAhora } from "@/lib/horario.js";
import { enlaceCompartir } from "@/lib/whatsapp.js";
import { ALCANCE_ENVIO, MODALIDAD_COCINA, QUE_HACES } from "@/lib/vendedor.js";
import { miniatura, PRODUCTOS_POR_PAGINA } from "@/lib/publicacion.js";
import { mostrarPrecio } from "@/lib/precio.js";

const { t, productos = [], hayMas = false, ver = PRODUCTOS_POR_PAGINA } = Astro.props;
const primeroNuevo = ver - PRODUCTOS_POR_PAGINA; // al tocar "Ver más", la página baja hasta los nuevos
const municipio = t.zonas?.municipios;
const lugar = [t.zonas?.nombre, municipio?.nombre].filter(Boolean).join(", ");
const abierto = estaAbiertoAhora(t);
const esPersona = t.tipo === "persona";
const url = new URL(`/${t.slug}`, Astro.url.origin).href;
const descripcion = t.descripcion || `${QUE_HACES[t.seccion_principal]?.texto ?? "Tienda"} en ${lugar}. Escríbele por WhatsApp desde Lokl.`;
const hora = (h) => String(h).slice(0, 5);
---
<Base titulo={t.nombre} descripcion={descripcion} imagen={t.logo_url || undefined}>
  <main class="contenedor">
    <Cabecera lugar={municipio?.nombre} />

    <section class="cabecera-tienda">
      {t.logo_url ? <img src={t.logo_url} alt={`Logo de ${t.nombre}`} width="88" height="88" class="logo-tienda grande" />
        : <span class="logo-tienda logo-vacio grande">{t.nombre.slice(0, 1)}</span>}
      <div style="min-width:0">
        <h1 style="font-size:24px;margin:0;line-height:1.2">{t.nombre}</h1>
        {t.verificado_en && (
          <a href="/verificado" class="insignia-verificado"><Icono nombre="verificado" tam={16} /> Verificado por Lokl</a>
        )}
        {lugar && <p class="texto-2 fila" style="margin:4px 0 0;font-size:14px;gap:4px"><Icono nombre="ubicacion" tam={16} />{lugar}</p>}
        {!esPersona && (
          <p style="margin:6px 0 0;font-size:14px">
            <strong class:list={["estado-abierto", { cerrado: !abierto }]}>● {abierto ? "Abierto ahora" : "Cerrado ahora"}</strong>
            {t.hora_desde && <span class="texto-2"> · {hora(t.hora_desde)} a {hora(t.hora_hasta)}</span>}
          </p>
        )}
      </div>
    </section>

    <div class="pila-botones" style="margin-top:16px">
      <a class="boton ancho boton-whatsapp" href={`/c/${t.slug}/whatsapp`} rel="nofollow">
        <Icono nombre="whatsapp" tam={22} /> Escribir por WhatsApp
      </a>
      {t.telefono && <a class="boton boton-claro ancho" href={`/c/${t.slug}/llamada`} rel="nofollow">Llamar</a>}
    </div>

    {t.descripcion && <p style="margin:18px 0 0;white-space:pre-line">{t.descripcion}</p>}

    <ul class="datos-tienda">
      {t.modalidad_cocina && <li>{MODALIDAD_COCINA[t.modalidad_cocina]}</li>}
      {t.a_domicilio && <li>Entrega o atiende a domicilio</li>}
      {t.alcance_envio && t.alcance_envio !== "municipio" && <li>Envíos: {ALCANCE_ENVIO[t.alcance_envio].toLowerCase()}</li>}
      {t.envio_detalle && <li>{t.envio_detalle}</li>}
      {t.direccion && t.modalidad_cocina !== "desde_casa" && <li>{t.direccion}</li>}
      {t.maps_url && t.modalidad_cocina !== "desde_casa" && <li><a href={t.maps_url} rel="nofollow noopener">Ver en Google Maps</a></li>}
    </ul>

    {productos.length > 0 ? (
      <ul class="rejilla-productos">
        {productos.map((p, i) => {
          const mini = miniatura(p);
          const precio = mostrarPrecio(p.precio, p.moneda);
          return (
            <li id={i === primeroNuevo && i > 0 ? "mas" : undefined}>
              <a href={`/p/${p.id}`} class:list={["tarjeta enlace-tarjeta producto", { agotado: p.agotado }]}>
                {mini ? <img src={mini} alt="" width="200" height="200" loading="lazy" decoding="async" />
                  : <span class="foto-vacia" aria-hidden="true"></span>}
                <span class="nombre-producto">{p.titulo}</span>
                <span class="precio-producto">{p.agotado ? "Agotado" : precio ?? "Pregunta el precio"}</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : null}
    {hayMas && (
      <a class="boton boton-claro ancho" href={`/${t.slug}?ver=${ver + PRODUCTOS_POR_PAGINA}#mas`} style="margin-top:14px" rel="nofollow">
        Ver más productos
      </a>
    )}
    {productos.length === 0 && (
      <p class="texto-2" style="margin:24px 0 0;font-size:14px;text-align:center">
        Todavía no hay {esPersona ? "anuncios" : "productos"} publicados. Escríbele por WhatsApp para preguntar.
      </p>
    )}

    <p style="margin-top:20px;text-align:center">
      <a href={enlaceCompartir(`Mira ${t.nombre} en Lokl: ${url}`)} class="texto-2" style="font-size:14px">Compartir esta tienda</a>
    </p>
  </main>
</Base>
