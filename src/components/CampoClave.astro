---
// Campo de contraseña con el "ojito" para verla mientras se escribe.
// Sin JavaScript es un campo normal (el ojito no aparece). Con JavaScript: ~0,4 KB en línea.
import Icono from "./Icono.astro";

const { etiqueta = "Contraseña", nombre = "clave", autocompletar = "current-password", ayuda = "" } = Astro.props;
---
<label>{etiqueta}
  <span class="campo-clave">
    <input type="password" name={nombre} required minlength="8" autocomplete={autocompletar} />
    <button type="button" class="ver-clave" aria-label="Mostrar contraseña" aria-pressed="false" hidden>
      <span class="ojo-abierto"><Icono nombre="ojo" tam={22} /></span>
      <span class="ojo-cerrado" hidden><Icono nombre="ojo-tachado" tam={22} /></span>
    </button>
  </span>
  {ayuda && <small class="texto-2">{ayuda}</small>}
</label>
<script is:inline>
  document.querySelectorAll(".ver-clave").forEach((b) => {
    if (b.dataset.listo) return;
    b.dataset.listo = "1";
    b.hidden = false;
    const campo = b.parentElement.querySelector("input");
    b.addEventListener("click", () => {
      const ver = campo.type === "password";
      campo.type = ver ? "text" : "password";
      b.setAttribute("aria-pressed", String(ver));
      b.setAttribute("aria-label", ver ? "Ocultar contraseña" : "Mostrar contraseña");
      b.querySelector(".ojo-abierto").hidden = ver;
      b.querySelector(".ojo-cerrado").hidden = !ver;
      campo.focus();
    });
  });
</script>
