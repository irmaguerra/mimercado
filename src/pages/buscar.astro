---
// /buscar?q=queso&lugar=apure/san-fernando — Buscador de todo Lokl. HTML puro, 0 KB de JS.
// La ubicación ORDENA, no esconde: lo de tu ciudad primero, pero también sale lo de otros lugares.
// Filtros: ?seccion=comida y ?abiertos=1. Cada búsqueda queda anotada (con su número de resultados)
// para ver en el admin lo que la gente busca y no encuentra; por eso los resultados no se cachean.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import Icono from "@/components/Icono.astro";
import PedirPresupuesto from "@/components/PedirPresupuesto.astro";
import Mascota from "@/components/Mascota.astro";
import TarjetaVendedor from "@/components/TarjetaVendedor.astro";
import TarjetaProducto from "@/components/TarjetaProducto.astro";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { leerUbicacion, buscarMunicipio, buscarEstado } from "@/lib/ubicacion.js";
import { PUBLICA } from "@/lib/cache.js";
import { SECCIONES, seccionPorSlug, agruparResultados, leerLugar, contar } from "@/lib/listados.js";
import { MUNICIPIO_SUPER, municipioSuper } from "@/lib/super.js";
import { mostrarPrecio } from "@/lib/precio.js";
import { enlaceCompartir } from "@/lib/whatsapp.js";

const params = Astro.url.searchParams;

// Sin ?lugar= se usa la ubicación guardada en el teléfono, y se pone en la dirección
// para que la página dependa solo de la dirección (así se puede compartir y guardar).
let lugar = leerLugar(params.get("lugar"));
if (!lugar) {
  const guardada = leerUbicacion(Astro.cookies);
  if (guardada) {
    const nueva = new URL(Astro.url);
    nueva.searchParams.set("lugar", guardada.municipio ? `${guardada.estado}/${guardada.municipio}` : guardada.estado);
    return Astro.redirect(nueva.pathname + nueva.search, 302);
  }
}

const m = lugar?.municipio ? await buscarMunicipio(lugar.estado, lugar.municipio) : null;
const e = !m && lugar ? await buscarEstado(lugar.estado) : null;
const nombreLugar = m?.nombre ?? e?.nombre ?? "";
const valorLugar = m ? `${m.estado.slug}/${m.slug}` : e ? e.slug : "";

const q = (params.get("q") || "").trim().slice(0, 80);
const sec = seccionPorSlug(params.get("seccion") || "");
const abiertos = params.get("abiertos") === "1";

let grupos = [], total = 0, fallo = false, delSuper = [];
if (q.length >= 2) {
  const { data, error } = await supabasePublico().rpc("buscar", {
    q,
    p_cerca_municipio_id: m?.id ?? null,
    p_seccion: sec?.clave ?? null,
    p_solo_abiertos: abiertos,
    p_limite: 60,
  });
  if (error) { console.error("buscar", error); fallo = true; }
  total = data?.length ?? 0;
  grupos = agruparResultados(data ?? []);
  // Lokl Súper primero (decisión 63): solo donde reparte (San Fernando) o si no se eligió lugar.
  if (!sec && !abiertos && (!lugar?.municipio || m?.slug === MUNICIPIO_SUPER)) {
    const pub = supabasePublico();
    const muniSuper = await municipioSuper(pub);
    const { data: s } = await pub.rpc("super_buscar", { p_municipio_id: muniSuper, p_q: q, p_limite: 4 });
    delSuper = s ?? [];
  }
} else {
  Astro.cache.set(PUBLICA); // la página vacía es igual para todos
}

/** Dirección de esta búsqueda cambiando un filtro. */
const con = (cambios) => {
  const u = new URLSearchParams();
  if (q) u.set("q", q);
  if (valorLugar) u.set("lugar", valorLugar);
  const s = "seccion" in cambios ? cambios.seccion : sec?.slug;
  if (s) u.set("seccion", s);
  const a = "abiertos" in cambios ? cambios.abiertos : abiertos;
  if (a) u.set("abiertos", "1");
  return `/buscar?${u}`;
};
const comoTienda = (r) => ({
  slug: r.vendedor_slug, nombre: r.titulo, logo_url: r.foto_mini, zona: r.zona,
  verificado: r.verificado, abierto: r.abierto, descripcion: r.subtitulo, servicio: r.seccion === "servicios",
});
const comoProducto = (r) => ({
  id: r.id, titulo: r.titulo, precio: r.precio, moneda: r.moneda, precio_mayor: r.precio_mayor, unidad: r.unidad, foto_mini: r.foto_mini, agotado: r.agotado, zona: r.zona,
});
const raiz = m ? `/${m.estado.slug}/${m.slug}` : null;
---
<Base titulo={q ? `${q} · Buscar` : "Buscar"} descripcion="Busca lo que se vende y se ofrece cerca de ti. Todo termina en WhatsApp.">
  <main class="contenedor">
    <Cabecera lugar={nombreLugar} />

    <form action="/buscar" style="margin-top:18px" role="search">
      <label for="q" class="texto-2" style="font-size:14px">¿Qué buscas{nombreLugar && ` en ${nombreLugar}`}?</label>
      <div class="tarjeta fila" style="padding:0 12px;margin-top:6px">
        <Icono nombre="buscar" tam={20} class="texto-2" />
        <input id="q" name="q" type="search" class="campo-limpio" value={q} placeholder="Queso, moto taxi, pizza, plomero…" maxlength="80" enterkeyhint="search" />
        {valorLugar && <input type="hidden" name="lugar" value={valorLugar} />}
        {sec && <input type="hidden" name="seccion" value={sec.slug} />}
        {abiertos && <input type="hidden" name="abiertos" value="1" />}
        <button type="submit" class="boton-texto">Buscar</button>
      </div>
    </form>

    {q.length >= 2 && (
      <ul class="chips" aria-label="Filtrar">
        <li><a href={con({ abiertos: !abiertos })} class="chip" aria-current={abiertos ? "true" : undefined}>{abiertos ? "✓ " : ""}Abierto ahora</a></li>
        <li><a href={con({ seccion: null })} class="chip" aria-current={!sec ? "true" : undefined}>Todo</a></li>
        {SECCIONES.map((s) => (
          <li><a href={con({ seccion: s.slug })} class="chip" aria-current={sec?.slug === s.slug ? "true" : undefined}>{s.nombre}</a></li>
        ))}
      </ul>
    )}

    {fallo && <p class="mensaje error" role="alert">No pudimos buscar en este momento. Intenta de nuevo en un rato.</p>}

    {delSuper.length > 0 && (
      <section class="grupo-resultados">
        <h2 class="fila-entre" style="font-size:18px;margin:0">
          <span style="display:inline-flex;align-items:center;gap:6px"><span style="color:var(--marca)"><Icono nombre="super" tam={22} /></span>En Lokl Súper</span>
          <span class="texto-2" style="font-size:14px;font-weight:400">Te llega a tu puerta</span>
        </h2>
        <ul class="rejilla-productos">
          {delSuper.map((p) => (
            <li>
              <a href={`/super?q=${encodeURIComponent(q)}`} class="tarjeta enlace-tarjeta producto producto-super">
                {p.foto_url ? <img src={p.foto_url} alt="" width="240" height="240" loading="lazy" decoding="async" />
                  : <span class="foto-vacia foto-pasillo" aria-hidden="true"><Icono nombre="super" tam={44} /></span>}
                <span class="nombre-producto">{p.nombre}</span>
                {(p.marca || p.presentacion) && <span class="detalle-producto texto-2">{[p.marca, p.presentacion].filter(Boolean).join(" · ")}</span>}
                <span class="precio-producto">{mostrarPrecio(p.precio)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p style="margin:10px 0 0;font-size:14px"><a href={`/super?q=${encodeURIComponent(q)}`}>Pedir en Lokl Súper ›</a></p>
      </section>
    )}

    {grupos.map((g) => (
      <section class="grupo-resultados">
        <h2 class="fila-entre" style="font-size:18px;margin:0">
          <span>{g.seccion?.nombre ?? "Otros"}</span>
          <span class="texto-2" style="font-size:14px;font-weight:400">
            {[g.tiendas.length && contar(g.tiendas.length, g.clave), g.productos.length && `${g.productos.length} ${g.productos.length === 1 ? "producto" : "productos"}`].filter(Boolean).join(" · ")}
          </span>
        </h2>
        {g.tiendas.length > 0 && (
          <ul class="lista-vendedores">
            {g.tiendas.map((r) => <li><TarjetaVendedor v={comoTienda(r)} /></li>)}
          </ul>
        )}
        {g.productos.length > 0 && (
          <ul class="rejilla-productos">
            {g.productos.map((r) => <TarjetaProducto p={comoProducto(r)} />)}
          </ul>
        )}
        {raiz && g.seccion && (
          <p style="margin:10px 0 0;font-size:14px"><a href={`${raiz}/${g.seccion.slug}`}>Ver todo {g.seccion.nombre.toLowerCase()} en {m.nombre} ›</a></p>
        )}
      </section>
    ))}

    {q.length >= 2 && !fallo && total === 0 && !delSuper.length && (
      <div class="tarjeta aviso">
        <div style="float:right;margin:0 0 4px 8px"><Mascota pose="busca" tam={64} /></div>
        <strong style="display:block">No encontramos "{q}"{sec && ` en ${sec.nombre}`}{abiertos && " abierto ahora"}.</strong>
        <ul style="margin:8px 0 0;padding-left:20px">
          <li>Prueba con una palabra más corta o más general (por ejemplo "queso" en vez de "queso llanero de 1 kilo").</li>
          {(sec || abiertos) && <li><a href={con({ seccion: null, abiertos: false })}>Buscar en todo Lokl, abierto o cerrado</a></li>}
          <li>¿Lo vendes tú? <a href="/panel/publicar">Publícalo gratis</a> y la próxima persona que lo busque te encuentra.</li>
        </ul>
      </div>
    )}
    {q.length >= 2 && !fallo && total === 0 && !delSuper.length && (
      <div style="margin-top:12px">
        <PedirPresupuesto q={q} lugar={m ? `${m.estado.slug}/${m.slug}` : ""} titulo={`¿Nadie tiene "${q.length > 30 ? q.slice(0, 29) + "…" : q}"? Pide presupuesto`} texto="Dinos qué necesitas y los negocios que lo tengan te mandan su precio." />
      </div>
    )}

    {q.length >= 2 && !fallo && (total > 0 || delSuper.length > 0) && (
      <div class="tarjeta bloque compartir-busqueda">
        <p style="margin:0 0 4px"><strong>¿Alguien en tu grupo pregunta "¿quién vende {q.length > 30 ? q.slice(0, 29) + "…" : q}?"</strong></p>
        <p class="texto-2" style="margin:0 0 10px;font-size:14px">Respóndele con esta búsqueda: ve todos los que lo tienen, con precio y WhatsApp.</p>
        <a class="boton boton-claro ancho" href={enlaceCompartir(`¿Buscas ${q}${nombreLugar ? ` en ${nombreLugar}` : ""}? Mira quién lo tiene, con precios y WhatsApp 👉 ${Astro.url.origin}/buscar?q=${encodeURIComponent(q)}${valorLugar ? `&lugar=${valorLugar}` : ""}

🤝 Uno nos lleva a todos · #Lokéalo`)}>
          <Icono nombre="compartir" tam={20} /> Compartir esta búsqueda
        </a>
      </div>
    )}

    {q.length < 2 && (
      <>
        <h2 style="font-size:18px;margin:24px 0 10px">{raiz ? `Explora ${m.nombre}` : "Explora"}</h2>
        <ul class="rejilla-secciones">
          {SECCIONES.map((s) => (
            <li>
              <a href={raiz ? `${raiz}/${s.slug}` : "/ubicacion"} class="tarjeta enlace-tarjeta" style="display:block;padding:14px;height:100%">
                <span style="color:var(--marca)"><Icono nombre={s.icono} tam={28} /></span>
                <strong style="display:block;margin-top:8px">{s.nombre}</strong>
                <span class="texto-2" style="font-size:14px">{s.detalle}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </main>
</Base>
