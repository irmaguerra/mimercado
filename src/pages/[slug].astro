---
// Primer nivel de la dirección: usalokl.com/<algo>
//  - Si <algo> es un estado (/apure, /zulia) → página del estado.
//  - Si es el enlace de un vendedor (/queseria-la-macanilla) → su tienda.
// Los slugs de los estados están reservados en la base: ningún vendedor puede usarlos.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import Icono from "@/components/Icono.astro";
import PaginaTienda from "@/components/PaginaTienda.astro";
import TarjetaVendedor from "@/components/TarjetaVendedor.astro";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { buscarEstado, municipiosActivos } from "@/lib/ubicacion.js";
import { PUBLICA } from "@/lib/cache.js";
import { productosDeTienda, cuantosVer } from "@/lib/publicacion.js";

const slug = Astro.params.slug;
const estado = await buscarEstado(slug);

let tienda = null, productos = [], hayMas = false, ver = 0, galeria = [], sectores = [], todoMunicipio = false;
let resenas = [], resumen = { cantidad: 0, promedio: null };
if (!estado) {
  const { data } = await supabasePublico()
    .from("vendedores")
    .select("*, zonas!vendedores_zona_id_fkey(nombre, municipio_id, municipios(nombre, slug, estados(nombre, slug)))")
    .eq("slug", slug)
    .eq("estado", "activo")
    .maybeSingle();
  tienda = data;
  if (!tienda) return Astro.rewrite("/404");
  ver = cuantosVer(Astro.url.searchParams.get("ver"));
  const sb = supabasePublico();
  const conResenas = tienda.tipo !== "persona"; // decisión 32
  const [prod, { data: fotos }, { data: cubiertas }, { data: ultimas }, { data: res }] = await Promise.all([
    productosDeTienda(sb, tienda.id, ver),
    sb.from("vendedor_fotos").select("url, url_mini, orden").eq("vendedor_id", tienda.id).order("orden"),
    tienda.seccion_principal === "servicios"
      ? sb.from("vendedor_zonas").select("zonas(nombre, municipio_id)").eq("vendedor_id", tienda.id)
      : { data: [] },
    conResenas
      ? sb.from("resenas").select("id, nombre, estrellas, texto, creado_en, respuesta")
          .eq("vendedor_id", tienda.id).eq("estado", "publicada").order("creado_en", { ascending: false }).limit(5)
      : { data: [] },
    conResenas ? sb.rpc("resumen_resenas", { p_vendedor: tienda.id }) : { data: [] },
  ]);
  ({ productos, hayMas } = prod);
  resenas = ultimas ?? [];
  if (res?.[0]) resumen = res[0];
  galeria = fotos ?? [];
  sectores = (cubiertas ?? []).map((c) => c.zonas).filter(Boolean);
  // Si cubre todos los sectores de su ciudad, se dice "Va a todo San Fernando"
  const muni = tienda.zonas?.municipio_id;
  if (sectores.length && muni) {
    const { count } = await sb.from("zonas").select("id", { count: "exact", head: true }).eq("municipio_id", muni).eq("activa", true);
    todoMunicipio = count > 0 && sectores.filter((z) => z.municipio_id === muni).length >= count;
  }
}
Astro.cache.set(PUBLICA);

let municipios = [], activosAqui = [], otrosLugares = [], nacionales = [];
if (estado) {
  const [{ data }, activos] = await Promise.all([
    supabasePublico().from("municipios").select("nombre, slug, activo").eq("estado_id", estado.id).order("nombre"),
    municipiosActivos(),
  ]);
  municipios = data ?? [];
  activosAqui = municipios.filter((m) => m.activo);
  if (!activosAqui.length) {
    const { data: n } = await supabasePublico().rpc("productores_nacionales", { p_limite: 12 });
    nacionales = n ?? [];
  }
  otrosLugares = activos.filter((c) => c.estado.slug !== estado.slug);
}
---
{tienda ? <PaginaTienda t={tienda} productos={productos} hayMas={hayMas} ver={ver} galeria={galeria} sectores={sectores} todoMunicipio={todoMunicipio} resenas={resenas} resumen={resumen} /> : (
<Base titulo={estado.nombre} descripcion={`Lo que se vende y se ofrece en ${estado.nombre}, ordenado. Todo termina en WhatsApp.`}>
  <main class="contenedor">
    <Cabecera lugar={estado.nombre} />
    <h1 style="font-size:24px;margin:20px 0 8px">{estado.nombre}</h1>

    {activosAqui.length === 0 && (
      <div class="tarjeta aviso">
        <strong style="display:block">Lokl todavía no llega a {estado.nombre}.</strong>
        Pero puedes ver lo que se vende en otros lugares y lo que te envían a todo el país.
      </div>
    )}

    {nacionales.length > 0 && (
      <>
        <h2 style="font-size:18px;margin:24px 0 4px">Envían a todo el país</h2>
        <p class="texto-2" style="margin:0;font-size:14px">Productores y tiendas que mandan por encomienda hasta {estado.nombre}.</p>
        <ul class="lista-vendedores">
          {nacionales.map((v) => (
            <li><TarjetaVendedor v={{ ...v, zona: [v.municipio, v.estado].join(", "), descripcion: v.envio_detalle }} mostrarAbierto={false} /></li>
          ))}
        </ul>
        <p style="margin:10px 0 0"><a href="/precios?nacional=1">Ver sus precios de origen ›</a></p>
      </>
    )}

    {otrosLugares.length > 0 && activosAqui.length === 0 && (
      <>
        <h2 style="font-size:18px;margin:24px 0 10px">Mira lo que se vende en</h2>
        <ul class="lista-opciones">
          {otrosLugares.map((c) => (
            <li>
              <a href={`/${c.estado.slug}/${c.slug}`} class="tarjeta enlace-tarjeta opcion-grande">
                <span style="color:var(--marca)"><Icono nombre="ubicacion" tam={28} /></span>
                <span>
                  <strong style="display:block;font-size:18px">{c.nombre}</strong>
                  <span class="texto-2">{c.estado.nombre}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {municipios.length > 0 && (
      <>
        <h2 style="font-size:18px;margin:24px 0 10px">Municipios</h2>
        <ul class="rejilla-estados">
          {municipios.map((m) => (
            <li>
              <a href={`/${estado.slug}/${m.slug}`}>{m.nombre}{m.activo && <span class="punto-activo" title="Lokl activo"> ●</span>}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </main>
</Base>
)}
