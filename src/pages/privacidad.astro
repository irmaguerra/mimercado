---
// /privacidad — Política de privacidad en lenguaje sencillo. Google la exige para "Continuar con Google".
// HTML puro, cacheada como página informativa.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import { INFORMATIVA } from "@/lib/cache.js";
import { WHATSAPP_LOKL as WHATSAPP } from "@/lib/moderacion.js";

Astro.cache.set(INFORMATIVA);

const CORREO = "usalokl.app@gmail.com";
const mensaje = encodeURIComponent("Hola Lokl, quiero borrar mis datos.");
---
<Base titulo="Privacidad" descripcion="Qué datos guarda Lokl, para qué los usa y cómo pedir que se borren.">
  <main class="contenedor angosto">
    <Cabecera />
    <h1 style="font-size:24px;margin:20px 0 8px">Privacidad en Lokl</h1>
    <p>Lokl ordena lo que se vende y se ofrece en tu zona. Guardamos solo lo necesario para que eso funcione. <strong>No vendemos ni regalamos tus datos a nadie.</strong></p>

    <h2 style="font-size:18px;margin:22px 0 6px">Si vendes u ofreces servicios</h2>
    <ul style="margin:0;padding-left:20px">
      <li>Tu <strong>correo</strong> para entrar. Si entras con Google, Google nos da tu nombre, tu correo y tu foto. No vemos tu contraseña de Google.</li>
      <li>Los datos de tu tienda que tú publicas: nombre, WhatsApp, zona, horario, fotos y productos. Esos datos son públicos para que los clientes te encuentren.</li>
    </ul>

    <h2 style="font-size:18px;margin:22px 0 6px">Si compras o buscas</h2>
    <ul style="margin:0;padding-left:20px">
      <li>No necesitas cuenta. Tu teléfono guarda un <strong>código anónimo</strong> para recordar tus favoritos, tus pedidos y tus opiniones.</li>
      <li>Tu zona, para mostrarte primero lo que tienes cerca.</li>
      <li>Si haces un <strong>pedido al Lokl Súper</strong>: tu nombre, WhatsApp, sector y dirección, para llevarte el pedido.</li>
      <li>Si <strong>pides presupuesto</strong>: tu nombre, WhatsApp y lo que buscas. Los vendedores ven lo que pides, pero <strong>no ven tu WhatsApp</strong>. Tú decides a quién escribirle.</li>
      <li>Si activas los <strong>avisos en el teléfono</strong>, guardamos el permiso para enviártelos. Los puedes apagar cuando quieras.</li>
      <li>Lo que se busca en Lokl, sin tu nombre, para saber qué hace falta en la zona.</li>
    </ul>

    <h2 style="font-size:18px;margin:22px 0 6px">Para qué los usamos</h2>
    <ul style="margin:0;padding-left:20px">
      <li>Para que Lokl funcione: mostrar tiendas y productos, entregar pedidos y responder presupuestos.</li>
      <li>Para cuidar la comunidad: revisar reportes y quitar lo que no cumple.</li>
      <li>Todo contacto entre clientes y vendedores es por WhatsApp. Lokl no cobra ni recibe pagos de vendedores.</li>
    </ul>

    <h2 style="font-size:18px;margin:22px 0 6px">Borrar tus datos</h2>
    <p>Puedes pedir que borremos tu cuenta o tus datos cuando quieras. Escríbenos por cualquiera de estas vías:</p>
    <ul style="margin:0 0 8px;padding-left:20px">
      <li>Correo: <a href={`mailto:${CORREO}`}>{CORREO}</a></li>
      <li>WhatsApp: <a href={`https://wa.me/${WHATSAPP}?text=${mensaje}`}>0424-3232671</a></li>
    </ul>
    <p class="tarjeta aviso">Si esta página cambia, lo diremos aquí mismo. Última actualización: noviembre de 2026.</p>
  </main>
</Base>
