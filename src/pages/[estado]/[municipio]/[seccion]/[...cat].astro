---
// Listado de una sección y, si viene, de su categoría y subcategoría:
//   /apure/san-fernando/comida
//   /apure/san-fernando/comida/pizza
//   /apure/san-fernando/servicios/transporte/moto-taxi
// Tiendas, Comida, Al mayor y Servicios muestran tiendas; Clasificados, productos (decisión 12).
// ?zona=<sector> pone primero lo de ese sector, sin esconder lo demás (decisión 13). HTML puro, 0 KB de JS.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import TarjetaVendedor from "@/components/TarjetaVendedor.astro";
import TarjetaProducto from "@/components/TarjetaProducto.astro";
import PedirPresupuesto from "@/components/PedirPresupuesto.astro";
import Icono from "@/components/Icono.astro";
import Mascota from "@/components/Mascota.astro";
import { buscarMunicipio } from "@/lib/ubicacion.js";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { PUBLICA } from "@/lib/cache.js";
import {
  seccionPorSlug, categoriasDeSeccion, idsDeCategoria, zonasDeMunicipio,
  listarVendedores, listarPublicaciones, cuantosVer, POR_PAGINA, NOMBRE_TIENDAS,
} from "@/lib/listados.js";

const { estado, municipio, seccion, cat } = Astro.params;
const sec = seccionPorSlug(seccion);
if (!sec) return Astro.rewrite("/404");
const m = await buscarMunicipio(estado, municipio);
if (!m) return Astro.rewrite("/404");

const sb = supabasePublico();
const [arbol, zonas] = await Promise.all([categoriasDeSeccion(sb, sec.clave), zonasDeMunicipio(sb, m.id)]);

// Categoría y subcategoría de la dirección
const partes = (cat ?? "").split("/").filter(Boolean);
const cat1 = partes[0] ? arbol.find((c) => c.slug === partes[0]) : null;
const cat2 = partes[1] ? cat1?.hijos.find((c) => c.slug === partes[1]) : null;
if (partes.length > 2 || (partes[0] && !cat1) || (partes[1] && !cat2)) return Astro.rewrite("/404");
const actual = cat2 ?? cat1;

const zonaSlug = Astro.url.searchParams.get("zona") || "";
const zona = zonas.find((z) => z.slug === zonaSlug) ?? null;
const ver = cuantosVer(Astro.url.searchParams.get("ver"));
// Filtros de Servicios (decisión 26): "A domicilio" y "24 horas"
const esServicios = sec.clave === "servicios";
const aDomicilio = esServicios && Astro.url.searchParams.get("domicilio") === "1";
const h24 = esServicios && Astro.url.searchParams.get("h24") === "1";
const primeroNuevo = ver - POR_PAGINA;

const consulta = { municipioId: m.id, seccion: sec.clave, categorias: idsDeCategoria(actual), zonaId: zona?.id ?? null, limite: ver, aDomicilio, h24 };
const { filas, hayMas } = sec.lista === "tiendas" ? await listarVendedores(sb, consulta) : await listarPublicaciones(sb, consulta);
Astro.cache.set(PUBLICA);

const raiz = `/${m.estado.slug}/${m.slug}`;
const base = `${raiz}/${sec.slug}`;
const conZona = (ruta, extra = "", filtros = {}) => {
  const q = new URLSearchParams();
  if (zona) q.set("zona", zona.slug);
  if ("domicilio" in filtros ? filtros.domicilio : aDomicilio) q.set("domicilio", "1");
  if ("h24" in filtros ? filtros.h24 : h24) q.set("h24", "1");
  if (extra) q.set("ver", extra);
  const s = q.toString();
  return s ? `${ruta}?${s}` : ruta;
};

// Botones de arriba: subcategorías si la categoría tiene, si no las categorías de la sección
const grupo = cat1?.hijos.length ? cat1 : null;
const chips = grupo
  ? [{ nombre: `Todo ${grupo.nombre.toLowerCase()}`, ruta: `${base}/${grupo.slug}`, activa: !cat2 },
     ...grupo.hijos.map((h) => ({ nombre: h.nombre, ruta: `${base}/${grupo.slug}/${h.slug}`, activa: cat2?.id === h.id }))]
  : [{ nombre: "Todo", ruta: base, activa: !cat1 },
     ...arbol.map((c) => ({ nombre: c.nombre, ruta: `${base}/${c.slug}`, activa: cat1?.id === c.id }))];

const ruta = Astro.url.pathname;
const titulo = actual ? `${actual.nombre} en ${m.nombre}` : `${sec.nombre} en ${m.nombre}`;
const [, plural] = NOMBRE_TIENDAS[sec.clave];
const vacio = actual
  ? `Todavía no hay ${plural} de ${actual.nombre.toLowerCase()} en ${m.nombre}.`
  : `Todavía no hay ${plural} en ${m.nombre}.`;
const filtrando = aDomicilio || h24;
// Portada de Servicios (decisión 84): bienvenida que invita a buscar y cuadrícula con todos los oficios a la vista
const portadaServicios = esServicios && !cat1;
const servicioVacio = esServicios && actual && !filtrando
  ? `Todavía nadie ofrece ${actual.nombre.toLowerCase()} en Lokl en ${m.nombre}.` : null;
---
<Base titulo={titulo} descripcion={`${titulo}, ${m.estado.nombre}. Míralos en Lokl y escríbeles por WhatsApp.`}>
  <main class="contenedor">
    <Cabecera lugar={m.nombre} />

    <nav class="migas texto-2" aria-label="Estás en">
      <a href={raiz}>{m.nombre}</a> ›
      {actual ? <a href={conZona(base)}>{sec.nombre}</a> : <span>{sec.nombre}</span>}
      {cat2 && <> › <a href={conZona(`${base}/${cat1.slug}`)}>{cat1.nombre}</a></>}
    </nav>
    {portadaServicios ? (
      <section class="tarjeta portada-servicios">
        <div style="float:right;margin:0 0 4px 8px"><Mascota pose="busca" tam={72} /></div>
        <h1 style="font-size:24px;line-height:1.2;margin:0 0 8px">¿Qué necesitas resolver hoy?</h1>
        <p style="margin:0 0 14px">El mototaxi, el plomero o la doctora que buscas está más cerca de lo que crees. <strong>Encuéntralo en {m.nombre} y escríbele directo por WhatsApp.</strong></p>
        <form action="/buscar" class="tarjeta fila" style="padding:0 12px;clear:both">
          <Icono nombre="buscar" tam={20} class="texto-2" />
          <input name="q" type="search" class="campo-limpio" placeholder="Plomero, mototaxi, uñas, abogado…" aria-label="¿Qué servicio buscas?" />
          <input type="hidden" name="lugar" value={`${m.estado.slug}/${m.slug}`} />
          <input type="hidden" name="seccion" value="servicios" />
        </form>
        <p class="texto-2" style="margin:10px 0 0;font-size:14px">✓ Directo con quien te atiende &nbsp;✓ Sin intermediarios &nbsp;✓ Gratis</p>
      </section>
    ) : (
      <h1 style="font-size:24px;margin:4px 0 0">{actual?.nombre ?? sec.nombre}</h1>
    )}

    {portadaServicios && (
      <>
        <h2 style="font-size:18px;margin:24px 0 10px">Elige lo que necesitas</h2>
        <ul class="rejilla-oficios">
          {arbol.map((g) => (
            <li class="tarjeta">
              <a href={conZona(`${base}/${g.slug}`)} class="fila oficio-grupo">
                <span style="color:var(--marca);flex:none"><Icono nombre={g.icono || "servicios"} tam={26} /></span>
                <strong>{g.nombre}</strong>
              </a>
              {g.hijos.length > 0 && (
                <p class="oficio-hijos">
                  {g.hijos.map((h, i) => <>{i > 0 && " · "}<a href={conZona(`${base}/${g.slug}/${h.slug}`)}>{h.nombre}</a></>)}
                </p>
              )}
            </li>
          ))}
        </ul>
        <h2 style="font-size:18px;margin:26px 0 0">{filas.length ? `Disponibles en ${m.nombre}` : `Quiénes ofrecen servicios en ${m.nombre}`}</h2>
      </>
    )}

    {chips.length > 1 && !portadaServicios && (
      <ul class="chips" aria-label="Categorías">
        {chips.map((c) => (
          <li><a href={conZona(c.ruta)} class="chip" aria-current={c.activa ? "page" : undefined}>{c.nombre}</a></li>
        ))}
      </ul>
    )}

    {esServicios && (
      <ul class="chips" aria-label="Filtrar" style="margin-top:8px">
        <li><a href={conZona(ruta, "", { domicilio: !aDomicilio })} class="chip" aria-current={aDomicilio ? "true" : undefined}>{aDomicilio && "✓ "}A domicilio</a></li>
        <li><a href={conZona(ruta, "", { h24: !h24 })} class="chip" aria-current={h24 ? "true" : undefined}>{h24 && "✓ "}24 horas</a></li>
      </ul>
    )}

    {zonas.length > 1 && (
      <form method="get" action={ruta} class="filtro-sector">
        {aDomicilio && <input type="hidden" name="domicilio" value="1" />}
        {h24 && <input type="hidden" name="h24" value="1" />}
        <label for="zona" class="texto-2">Ver primero</label>
        <select id="zona" name="zona">
          <option value="">Todo {m.nombre}</option>
          {zonas.map((z) => <option value={z.slug} selected={z.id === zona?.id}>{z.nombre}</option>)}
        </select>
        <button type="submit" class="boton boton-claro">Ver</button>
      </form>
    )}

    {sec.clave === "al_mayor" && (
      <p style="margin:12px 0 0"><a href={`/precios?lugar=${m.estado.slug}/${m.slug}`}>Ver la tabla de precios de origen ›</a></p>
    )}

    {!m.activo && (
      <p class="tarjeta aviso">Lokl está empezando en {m.nombre}. Aquí verás a los vendedores de la zona a medida que se registren.</p>
    )}

    {filas.length > 0 && sec.lista === "tiendas" && (
      <ul class="lista-vendedores">
        {filas.map((v, i) => (
          <li id={i === primeroNuevo && i > 0 ? "mas" : undefined}><TarjetaVendedor v={v} /></li>
        ))}
      </ul>
    )}
    {filas.length > 0 && sec.lista === "productos" && (
      <ul class="rejilla-productos">
        {filas.map((p, i) => <TarjetaProducto p={p} id={i === primeroNuevo && i > 0 ? "mas" : undefined} />)}
      </ul>
    )}

    {hayMas && (
      <a class="boton boton-claro ancho" href={`${conZona(ruta, String(ver + POR_PAGINA))}#mas`} style="margin-top:14px" rel="nofollow">
        Ver más
      </a>
    )}

    {filas.length === 0 && (
      <div class="tarjeta aviso" style="text-align:center">
        {servicioVacio ? (
          <>
            <p style="margin:0"><strong>{servicioVacio}</strong></p>
            <p style="margin:8px 0 0">¿Lo haces tú? <strong>Sé el primero:</strong> quien busque {actual.nombre.toLowerCase()} en {m.nombre} te va a encontrar a ti.</p>
          </>
        ) : portadaServicios && !filtrando ? (
          <>
            <p style="margin:0"><strong>Aquí van a estar los mejores de {m.nombre}.</strong></p>
            <p style="margin:8px 0 0">¿Ofreces un servicio? Los clientes empiezan a buscar aquí: que te encuentren a ti primero.</p>
          </>
        ) : (
          <p style="margin:0">{filtrando ? `No hay ${plural} con ese filtro todavía.` : vacio}</p>
        )}
        {filtrando && <p style="margin:8px 0 0"><a href={conZona(ruta, "", { domicilio: false, h24: false })}>Quitar los filtros</a></p>}
        <p style="margin:8px 0 0">
          {sec.clave === "clasificados"
            ? <a href="/panel/publicar">¿Vendes algo? Publícalo gratis</a>
            : esServicios ? <a href="/vende" class="boton ancho" style="margin-top:4px">Ofrecer mi servicio gratis</a>
            : <a href="/panel/crear">¿Tienes uno? Crea tu tienda gratis</a>}
        </p>
      </div>
    )}

    {sec.clave !== "clasificados" && m.activo && (
      <div style="margin-top:20px">
        <PedirPresupuesto
          cat={actual?.id}
          lugar={`${m.estado.slug}/${m.slug}`}
          titulo={esServicios ? (filas.length ? "¿No quieres llamar a uno por uno?" : "¿Lo necesitas ya? Pide presupuesto a varios") : filas.length ? "¿Quieres comparar precios?" : "Pide presupuesto a varios"}
          texto={actual ? `Dinos qué necesitas y varios negocios de ${actual.nombre.toLowerCase()} te mandan su precio.` : "Dinos qué necesitas y varios negocios te mandan su precio. Gratis."}
        />
      </div>
    )}

    {!portadaServicios && (
    <form action="/buscar" style="margin-top:24px">
      <div class="tarjeta fila" style="padding:0 12px">
        <input name="q" type="search" class="campo-limpio" placeholder={`Buscar en ${m.nombre}…`} aria-label="Buscar" />
        <input type="hidden" name="lugar" value={`${m.estado.slug}/${m.slug}`} />
        <button type="submit" class="boton-texto">Buscar</button>
      </div>
    </form>
    )}
  </main>
</Base>
