---
// /p/<id> — Ficha pública de un producto, plato, servicio o anuncio. HTML puro (0 KB de JavaScript).
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import Icono from "@/components/Icono.astro";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { fotosOrdenadas, vencida } from "@/lib/publicacion.js";
import { mostrarPrecio } from "@/lib/precio.js";
import { estaAbiertoAhora } from "@/lib/horario.js";
import { enlaceCompartir } from "@/lib/whatsapp.js";
import { PUBLICA } from "@/lib/cache.js";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.rewrite("/404");

const { data: p, error } = await supabasePublico()
  .from("publicaciones")
  .select(`id, titulo, descripcion, precio, moneda, seccion, estado, agotado, vence_en,
    publicacion_fotos(url, url_mini, orden),
    vendedores!publicaciones_vendedor_id_fkey(nombre, slug, logo_url, estado, tipo, verificado_en, telefono,
      hora_desde, hora_hasta, forzar_abierto, en_pausa,
      zonas!vendedores_zona_id_fkey(nombre, municipios(nombre)))`)
  .eq("id", id)
  .eq("estado", "publicada")
  .maybeSingle();
if (error) console.error("ficha", error);
const t = p?.vendedores;
if (!p || !t || t.estado !== "activo" || vencida(p)) return Astro.rewrite("/404");
Astro.cache.set(PUBLICA);

const fotos = fotosOrdenadas(p);
const precio = mostrarPrecio(p.precio, p.moneda);
const lugar = [t.zonas?.nombre, t.zonas?.municipios?.nombre].filter(Boolean).join(", ");
const esPersona = t.tipo === "persona";
const abierto = esPersona ? true : estaAbiertoAhora(t);
const url = new URL(`/p/${p.id}`, Astro.site).href;
const descripcion = [precio, p.descripcion?.slice(0, 150), `${t.nombre}${lugar ? ` · ${lugar}` : ""}`].filter(Boolean).join(" · ");
---
<Base titulo={p.titulo} descripcion={descripcion} imagen={fotos[0]?.url || t.logo_url || undefined}>
  <main class="contenedor angosto">
    <Cabecera lugar={t.zonas?.municipios?.nombre} />

    {fotos.length > 0 && (
      <div class="fotos-ficha">
        {fotos.map((f, i) => (
          <img src={f.url} alt={i === 0 ? p.titulo : `${p.titulo}, foto ${i + 1}`} width="600" height="600"
            loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} decoding="async" />
        ))}
      </div>
    )}
    {fotos.length > 1 && <p class="texto-2" style="font-size:13px;margin:4px 0 0;text-align:center">Desliza para ver {fotos.length} fotos</p>}

    <h1 style="font-size:24px;margin:16px 0 4px;line-height:1.25;word-break:break-word">{p.titulo}</h1>
    <p style="margin:0;font-size:22px;font-weight:800">
      {precio ?? <span class="texto-2" style="font-size:16px;font-weight:400">Pregunta el precio</span>}
    </p>
    {p.agotado && <p class="etiqueta-estado apagada" style="display:inline-block;margin-top:6px">Agotado por ahora</p>}

    <div class="pila-botones" style="margin-top:16px">
      <a class="boton ancho boton-whatsapp" href={`/c/${t.slug}/whatsapp?p=${p.id}`} rel="nofollow">
        <Icono nombre="whatsapp" tam={22} /> {p.agotado ? "Preguntar cuándo hay" : "Lo quiero: escribir por WhatsApp"}
      </a>
    </div>

    {p.descripcion && <p style="margin:18px 0 0;white-space:pre-line;word-break:break-word">{p.descripcion}</p>}

    <a href={`/${t.slug}`} class="tarjeta enlace-tarjeta tienda-en-ficha">
      {t.logo_url ? <img src={t.logo_url} alt="" width="48" height="48" class="logo-tienda" loading="lazy" />
        : <span class="logo-tienda logo-vacio" style="width:48px;height:48px;font-size:20px">{t.nombre.slice(0, 1)}</span>}
      <span style="min-width:0">
        <strong style="display:block">{t.nombre}</strong>
        {t.verificado_en && <span class="insignia-verificado" style="margin:0"><Icono nombre="verificado" tam={14} /> Verificado</span>}
        <span class="texto-2" style="display:block;font-size:14px">
          {!esPersona && <span class:list={["estado-abierto", { cerrado: !abierto }]}>● {abierto ? "Abierto" : "Cerrado"}</span>}
          {lugar && <>{!esPersona && " · "}{lugar}</>}
        </span>
        <span style="font-size:14px">{esPersona ? "Ver todo lo que vende ›" : "Ver la tienda ›"}</span>
      </span>
    </a>

    <p style="margin-top:20px;text-align:center">
      <a href={enlaceCompartir(`Mira esto en Lokl: ${p.titulo}${precio ? ` (${precio})` : ""} ${url}`)} class="texto-2" style="font-size:14px">Compartir</a>
    </p>
  </main>
</Base>
