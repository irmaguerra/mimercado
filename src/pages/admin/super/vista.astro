---
// /admin/super/vista — El Súper como lo verá el cliente (vista previa del admin).
// /super sigue en "Muy pronto" hasta que existan los pedidos (Módulo 10B).
// Lee como público (sin sesión) para mostrar exactamente lo que vería el cliente.
import Base from "@/layouts/Base.astro";
import CatalogoSuper from "@/components/CatalogoSuper.astro";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { configSuper, municipioSuper, pasillosSuper } from "@/lib/super.js";

const pub = supabasePublico();
const q = (Astro.url.searchParams.get("q") || "").trim().slice(0, 60);
const [muni, pasillos, cfg] = await Promise.all([municipioSuper(pub), pasillosSuper(pub), configSuper(pub)]);
const actual = pasillos.find((s) => s.slug === Astro.url.searchParams.get("pasillo")) || pasillos[0] || null;

let productos = [];
if (q.length >= 2) {
  const { data, error } = await pub.rpc("super_buscar", { p_municipio_id: muni, p_q: q, p_limite: 60 });
  if (error) console.error("super_buscar", error);
  productos = data || [];
} else if (actual) {
  const { data } = await pub.from("super_productos")
    .select("id, nombre, marca, presentacion, foto_url, precio")
    .eq("municipio_id", muni).eq("pasillo_id", actual.id).order("nombre");
  productos = data || [];
}
---
<Base titulo="Vista previa · Súper">
  <main class="contenedor" style="padding-top:20px">
    <p style="margin:0"><a href="/admin/super">‹ Lokl Súper</a></p>
    <p class="mensaje" style="margin-top:10px">👀 Vista previa: solo tú la ves. El cliente verá esto cuando abramos los pedidos (Módulo 10B). Solo aparecen los productos marcados, con precio y no agotados.</p>
    <h1 style="font-size:24px;margin:8px 0 0">Lokl Súper</h1>
    <CatalogoSuper productos={productos} pasillos={pasillos} actual={actual?.slug} q={q} base="/admin/super/vista" tasa={cfg.tasa} envio={cfg.envio} />
  </main>
</Base>
