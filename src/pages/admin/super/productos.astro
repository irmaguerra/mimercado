---
// /admin/super/productos — Elegir qué vender (decisión 53): la lista de sugerencias y los productos
// agregados a mano, por pasillo. Marcado = está en el catálogo. Sin precio, el cliente igual no lo ve.
import Base from "@/layouts/Base.astro";
import Icono from "@/components/Icono.astro";
import { municipioSuper, pasillosSuper } from "@/lib/super.js";

const { sb } = Astro.locals;
let aviso = "";
let error = "";
const muni = await municipioSuper(sb);

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const todos = String(f.get("ids") || "").split(",").map(Number).filter((n) => n > 0);
  const si = new Set(f.getAll("v").map(Number));
  const marcar = todos.filter((id) => si.has(id));
  const quitar = todos.filter((id) => !si.has(id));
  const r = await Promise.all([
    marcar.length ? sb.from("super_productos").update({ en_catalogo: true }).in("id", marcar) : { error: null },
    quitar.length ? sb.from("super_productos").update({ en_catalogo: false }).in("id", quitar) : { error: null },
  ]);
  const e = r.find((x) => x.error)?.error;
  if (e) { console.error("elegir", e); error = "No se pudo guardar."; }
  else aviso = `Listo: ${marcar.length} productos en tu catálogo.`;
}

const [pasillos, { data }] = await Promise.all([
  pasillosSuper(sb),
  sb.rpc("super_admin_productos", { p_municipio_id: muni, p_en_catalogo: null }),
]);
const productos = data || [];
const grupos = pasillos.map((s) => ({ ...s, items: productos.filter((p) => p.pasillo_id === s.id) })).filter((g) => g.items.length);
const marcados = productos.filter((p) => p.en_catalogo).length;
---
<Base titulo="Elegir qué vender · Súper">
  <main class="contenedor angosto" style="padding-top:20px">
    <p style="margin:0"><a href="/admin/super">‹ Lokl Súper</a></p>
    <h1 style="font-size:24px;margin:8px 0 4px">Elegir qué vender</h1>
    <p class="texto-2" style="margin:0;font-size:14px">
      Marca lo que vas a vender y toca <strong>Guardar</strong> al final. Ninguno trae precio: después
      le pones lo que te cuesta en <a href="/admin/super/precios">Precios</a>. Lo que no marques no se borra; queda aquí por si lo quieres después.
    </p>
    {aviso && <p class="mensaje ok" role="status">{aviso} <a href="/admin/super/precios?sin=1">Poner precios ›</a></p>}
    {error && <p class="mensaje error" role="alert">{error}</p>}

    <ul class="chips" aria-label="Ir al pasillo">
      {grupos.map((g) => <li><a class="chip" href={`#p-${g.slug}`}>{g.nombre}</a></li>)}
    </ul>

    <form method="post" id="elegir">
      <input type="hidden" name="ids" value={productos.map((p) => p.id).join(",")} />
      {grupos.map((g) => (
        <section id={`p-${g.slug}`} class="grupo-super">
          <div class="fila-entre">
            <h2 style="font-size:18px;margin:0">{g.nombre}</h2>
            <button type="button" class="boton-texto" data-todos={g.slug}>Marcar todos</button>
          </div>
          <ul class="lista-elegir" data-pasillo={g.slug}>
            {g.items.map((p) => (
              <li>
                <label class="fila-producto-super">
                  <input type="checkbox" name="v" value={p.id} checked={p.en_catalogo} />
                  {p.foto_url ? <img src={p.foto_url} alt="" width="48" height="48" loading="lazy" decoding="async" />
                    : <span class="mini-pasillo" aria-hidden="true"><Icono nombre="super" tam={22} /></span>}
                  <span><strong>{p.nombre}</strong>{(p.marca || p.presentacion) && <span class="texto-2"><br />{[p.marca, p.presentacion].filter(Boolean).join(" · ")}</span>}</span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="barra-guardar">
        <button class="boton ancho" type="submit">Guardar ({marcados} marcados al abrir)</button>
      </div>
    </form>
  </main>
  <script is:inline>
    document.querySelectorAll("[data-todos]").forEach((b) => b.addEventListener("click", () => {
      const cajas = document.querySelectorAll(`[data-pasillo="${b.dataset.todos}"] input`);
      const todas = [...cajas].every((c) => c.checked);
      cajas.forEach((c) => { c.checked = !todas; });
      b.textContent = todas ? "Marcar todos" : "Quitar todos";
    }));
  </script>
</Base>
