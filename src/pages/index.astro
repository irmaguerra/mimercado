---
// Entrada a usalokl.com:
//  - Si la persona ya eligió dónde está → la lleva a la portada de su ciudad (o estado).
//  - Si es su primera vez → "¿Dónde estás?" (un toque, sin GPS).
// No se cachea: la respuesta depende de la cookie de cada persona.
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import SelectorUbicacion from "@/components/SelectorUbicacion.astro";
import { leerUbicacion, rutaUbicacion } from "@/lib/ubicacion.js";

const ubicacion = leerUbicacion(Astro.cookies);
if (ubicacion) return Astro.redirect(rutaUbicacion(ubicacion), 302);
---
<Base>
  <main class="contenedor">
    <Cabecera />
    <SelectorUbicacion />
  </main>
</Base>
