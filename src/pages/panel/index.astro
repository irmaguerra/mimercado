---
// /panel — "Mi tienda": enlace, abierto/cerrado, contador de contactos y accesos.
import Base from "@/layouts/Base.astro";
import Icono from "@/components/Icono.astro";
import { miTienda } from "@/lib/sesion.js";
import { estaAbiertoAhora, dentroDeHorario } from "@/lib/horario.js";
import { enlaceCompartir } from "@/lib/whatsapp.js";
import { esServicio, textoAbierto } from "@/lib/vendedor.js";

const { sb, usuario } = Astro.locals;
const t = await miTienda(sb, usuario.id);
if (!t) {
  // La cuenta administradora no necesita tienda: va a la administración.
  const { data: admin } = await sb.rpc("es_admin");
  return Astro.redirect(admin ? "/admin" : "/panel/crear", 302);
}

const [{ data: semana }, { data: esAdmin }, { count: categorias }, { count: resenasTotal }] = await Promise.all([
  sb.rpc("mi_resumen_semana"),
  sb.rpc("es_admin"),
  sb.from("vendedor_categorias").select("categoria_id", { count: "exact", head: true }).eq("vendedor_id", t.id),
  sb.from("resenas").select("id", { count: "exact", head: true }).eq("vendedor_id", t.id).eq("estado", "publicada"),
]);
const s = semana?.[0] ?? { whatsapp: 0, llamadas: 0, personas: 0, favoritos: 0, resenas_nuevas: 0 };
const veces = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;
const faltanCategorias = t.seccion_principal && t.seccion_principal !== "clasificados" && !categorias;

const abierto = estaAbiertoAhora(t);
const enHorario = dentroDeHorario(t.hora_desde, t.hora_hasta);
// Los servicios dicen "Disponible / No disponible" con el mismo botón (decisión 23)
const servicio = esServicio(t);
const [palAbierto, palCerrado] = servicio ? ["disponible", "no disponible"] : ["abierto", "cerrado"];
const textoBoton = t.forzar_abierto === true ? "Volver a mi horario"
  : servicio ? (abierto ? "No estoy disponible" : "Estoy disponible")
  : abierto ? "Cerrar ahora" : "Abrir ahora";
const explicacion =
  t.forzar_abierto === true ? `Lo pusiste ${palAbierto} a mano. Se mantiene así hasta que toques el botón.`
  : t.forzar_abierto === false ? `Lo pusiste ${palCerrado} a mano. Se mantiene así hasta que toques el botón.`
  : t.atiende_24h ? `Atiendes las 24 horas: sales siempre ${palAbierto}.`
  : t.hora_desde ? `Sigue tu horario: ${t.hora_desde.slice(0, 5)} a ${t.hora_hasta.slice(0, 5)}.`
  : `Sin horario: se muestra siempre ${palAbierto}. Puedes poner tu horario en "Editar mi tienda".`;

const url = `${Astro.url.origin}/${t.slug}`;
const zonaPendiente = t.zonas && t.zonas.activa === false;
const suspendida = t.estado !== "activo";
---
<Base titulo="Mi tienda">
  <main class="contenedor angosto" style="padding-top:20px">
    <header class="fila" style="gap:12px">
      <a href="/panel/tienda" aria-label="Cambiar logo">
        {t.logo_url ? <img src={t.logo_url} alt="" width="56" height="56" class="logo-tienda" />
          : <span class="logo-tienda logo-vacio">{t.nombre.slice(0, 1)}</span>}
      </a>
      <div style="min-width:0">
        <h1 style="font-size:22px;margin:0">{t.nombre}</h1>
        <a href={`/${t.slug}`} class="texto-2" style="font-size:14px;word-break:break-all">{url.replace(/^https?:\/\//, "")}</a>
      </div>
    </header>

    <a class="boton boton-claro ancho" href="/panel/tienda" style="margin-top:14px">
      {t.logo_url ? "Editar mi tienda" : "Ponerle logo, horario y descripción"}
    </a>

    {suspendida && <p class="mensaje error">Tu tienda está suspendida y no aparece en Lokl. {t.motivo_suspension} Escríbenos para revisarlo.</p>}
    {faltanCategorias && (
      <p class="mensaje ok">
        Para salir en las listas (por ejemplo "Pizza" o "Moto taxi"), marca qué vendes.
        <a href="/panel/tienda#categorias">Elegir mis categorías</a>
      </p>
    )}
    {zonaPendiente && <p class="mensaje ok">Tu zona "{t.zonas.nombre}" está en revisión. Tu tienda ya funciona.</p>}

    <section class="tarjeta bloque">
      <div class="fila-entre">
        <strong class:list={["estado-abierto", { cerrado: !abierto }]}>● {textoAbierto(abierto, servicio).replace(" ahora", "")}</strong>
        <form method="post" action="/panel/abrir"><button class="boton boton-claro" type="submit">{textoBoton}</button></form>
      </div>
      <p class="texto-2" style="font-size:14px;margin:8px 0 0">{explicacion}</p>
    </section>

    <section class="tarjeta bloque">
      <p style="margin:0;font-size:15px">Esta semana</p>
      <p style="margin:2px 0 0"><strong style="font-size:30px">{s.personas}</strong> {s.personas === 1 ? "persona te contactó" : "personas te contactaron"} desde Lokl</p>
      <ul class="resumen-semana">
        <li><strong>{s.whatsapp}</strong><span class="texto-2">{veces(s.whatsapp, "mensaje", "mensajes")} por WhatsApp</span></li>
        <li><strong>{s.llamadas}</strong><span class="texto-2">{veces(s.llamadas, "llamada", "llamadas")}</span></li>
        {t.tipo !== "persona" && <li><strong>{s.favoritos}</strong><span class="texto-2">te {s.favoritos === 1 ? "guardó" : "guardaron"} en favoritos</span></li>}
        {t.tipo !== "persona" && <li><strong>{s.resenas_nuevas}</strong><span class="texto-2">{veces(s.resenas_nuevas, "reseña nueva", "reseñas nuevas")}</span></li>}
      </ul>
    </section>

    <div class="pila-botones" style="margin-top:16px">
      <a class="boton ancho" href={enlaceCompartir(`Mira ${t.tipo === "persona" ? "lo que vendo" : "mi tienda"} en Lokl y escríbeme por WhatsApp: ${url}`)}>
        <Icono nombre="whatsapp" tam={20} /> Compartir mi tienda
      </a>
      <button class="boton boton-claro ancho" type="button" data-copiar={url} hidden>Copiar mi enlace</button>
    </div>

    <nav class="menu-panel" aria-label="Opciones de mi tienda">
      <a href="/panel/tienda">Editar mi tienda <span aria-hidden="true">›</span></a>
      {t.tipo !== "persona" && <a href="/panel/mas">{servicio ? "Fotos, pagos, sectores y precios" : "Fotos de mi local y formas de pago"} <span aria-hidden="true">›</span></a>}
      <a href="/panel/publicar">Publicar <span aria-hidden="true">›</span></a>
      <a href="/panel/publicaciones">Mis publicaciones <span aria-hidden="true">›</span></a>
      {t.tipo !== "persona" && <a href="/panel/resenas">Opiniones de mis clientes{resenasTotal ? ` (${resenasTotal})` : ""} <span aria-hidden="true">›</span></a>}
      <a href={`/${t.slug}`}>Ver mi tienda como la ven los clientes <span aria-hidden="true">›</span></a>
      {esAdmin && <a href="/admin">Administración de Lokl <span aria-hidden="true">›</span></a>}
    </nav>

    <form method="post" action="/salir" style="margin-top:20px;text-align:center">
      <button type="submit" class="boton-texto">Salir de mi cuenta</button>
    </form>
  </main>
  <script is:inline>
    // Botón "Copiar": solo aparece si el teléfono lo permite.
    document.querySelectorAll("[data-copiar]").forEach((b) => {
      if (!navigator.clipboard) return;
      b.hidden = false;
      b.addEventListener("click", () => navigator.clipboard.writeText(b.dataset.copiar).then(() => { b.textContent = "¡Enlace copiado!"; }));
    });
  </script>
</Base>
