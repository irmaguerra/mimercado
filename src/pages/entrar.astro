---
// /entrar — Crear cuenta o entrar (vendedores y personas que publican clasificados).
// "Continuar con Google" (un toque) o correo + contraseña. Formularios normales: sin JavaScript.
import Base from "@/layouts/Base.astro";
import Logo from "@/components/Logo.astro";
import { destinoSeguro, mensajeError } from "@/lib/sesion.js";

const { sb, usuario } = Astro.locals;
const siguiente = destinoSeguro(Astro.url.searchParams.get("siguiente"));
let modo = Astro.url.searchParams.get("modo") || "entrar"; // entrar | registro | olvide
if (!["entrar", "registro", "olvide"].includes(modo)) modo = "entrar";

if (usuario && Astro.request.method === "GET") return Astro.redirect(siguiente, 302);

let error = "";
let aviso = Astro.url.searchParams.get("aviso") || "";
let correo = "";

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  modo = String(f.get("modo") || "entrar");
  correo = String(f.get("correo") || "").trim().toLowerCase();
  const clave = String(f.get("clave") || "");
  const volver = `${Astro.url.origin}/auth/callback?siguiente=${encodeURIComponent(siguiente)}`;

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) {
    error = "Escribe un correo válido.";
  } else if (modo === "olvide") {
    const { error: e } = await sb.auth.resetPasswordForEmail(correo, {
      redirectTo: `${Astro.url.origin}/auth/callback?siguiente=/entrar/nueva-clave`,
    });
    if (e) error = mensajeError(e);
    else aviso = "Si ese correo tiene cuenta, te enviamos un enlace para crear una contraseña nueva. Revisa también la carpeta de spam.";
  } else if (clave.length < 8) {
    error = "La contraseña debe tener al menos 8 caracteres.";
  } else if (modo === "registro") {
    const { data, error: e } = await sb.auth.signUp({ email: correo, password: clave, options: { emailRedirectTo: volver } });
    if (e) error = mensajeError(e);
    else if (data.session) return Astro.redirect(siguiente, 303); // si la confirmación de correo está apagada
    else aviso = `Te enviamos un correo a ${correo}. Toca el enlace que trae para activar tu cuenta (revisa también spam).`;
  } else {
    const { error: e } = await sb.auth.signInWithPassword({ email: correo, password: clave });
    if (e) error = mensajeError(e);
    else return Astro.redirect(siguiente, 303);
  }
}

const titulos = { entrar: "Entrar", registro: "Crea tu tienda gratis", olvide: "Recuperar contraseña" };
const enlace = (m) => `/entrar?modo=${m}${siguiente !== "/panel" ? `&siguiente=${encodeURIComponent(siguiente)}` : ""}`;
---
<Base titulo={titulos[modo]} barra={false}>
  <main class="contenedor angosto" style="padding-top:28px">
    <a href="/" aria-label="Lokl, inicio" style="color:var(--texto)"><Logo alto={36} /></a>
    <h1 style="font-size:24px;margin:20px 0 6px">{titulos[modo]}</h1>
    {modo === "registro" && <p class="texto-2" style="margin:0 0 12px">Sin pagos y sin aprobaciones. Tu tienda queda lista en menos de 2 minutos.</p>}

    {error && <p class="mensaje error" role="alert">{error}</p>}
    {aviso && <p class="mensaje ok" role="status">{aviso}</p>}

    {modo !== "olvide" && (
      <>
        <a href={`/auth/google?siguiente=${encodeURIComponent(siguiente)}`} class="boton boton-claro ancho">
          <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          Continuar con Google
        </a>
        <p class="separador"><span>o con tu correo</span></p>
      </>
    )}

    <form method="post" class="formulario">
      <input type="hidden" name="modo" value={modo} />
      <label>Correo
        <input type="email" name="correo" value={correo} required autocomplete="email" inputmode="email" />
      </label>
      {modo !== "olvide" && (
        <label>Contraseña
          <input type="password" name="clave" required minlength="8"
            autocomplete={modo === "registro" ? "new-password" : "current-password"} />
          {modo === "registro" && <small class="texto-2">Mínimo 8 caracteres.</small>}
        </label>
      )}
      <button class="boton ancho" type="submit">
        {modo === "registro" ? "Crear mi cuenta" : modo === "olvide" ? "Enviarme el enlace" : "Entrar"}
      </button>
    </form>

    <p class="enlaces-pie">
      {modo === "entrar" && <><a href={enlace("registro")}>¿No tienes cuenta? Crea tu tienda</a><a href={enlace("olvide")}>Olvidé mi contraseña</a></>}
      {modo === "registro" && <a href={enlace("entrar")}>¿Ya tienes cuenta? Entrar</a>}
      {modo === "olvide" && <a href={enlace("entrar")}>Volver a entrar</a>}
    </p>
  </main>
</Base>
