---
// /super — Lokl Súper (Módulo 10B): catálogo con carrito en el teléfono.
// HTML + ~1,3 KB en línea para el carrito. Cacheada 60 s: precios y horario se refrescan solos.
// Mientras no haya ningún producto a la venta, muestra "Muy pronto" (decisión 43).
import Base from "@/layouts/Base.astro";
import Cabecera from "@/components/Cabecera.astro";
import Icono from "@/components/Icono.astro";
import CatalogoSuper from "@/components/CatalogoSuper.astro";
import { supabasePublico } from "@/lib/supabase/servidor.js";
import { PUBLICA } from "@/lib/cache.js";
import { configSuper, municipioSuper, pasillosSuper, horarioSuper } from "@/lib/super.js";

Astro.cache.set(PUBLICA);
const pub = supabasePublico();
const q = (Astro.url.searchParams.get("q") || "").trim().slice(0, 60);
const [muni, pasillosTodos, cfg, { data: horario }] = await Promise.all([
  municipioSuper(pub), pasillosSuper(pub), configSuper(pub),
  pub.from("configuracion").select("valor").eq("clave", "super_horario").maybeSingle(),
]);

// Solo los pasillos que tienen algo a la venta.
const { data: conPrecio } = await pub.from("super_productos").select("pasillo_id").eq("municipio_id", muni);
const usados = new Set((conPrecio || []).map((r) => r.pasillo_id));
const pasillos = pasillosTodos.filter((s) => usados.has(s.id));
const actual = pasillos.find((s) => s.slug === Astro.url.searchParams.get("pasillo")) || pasillos[0] || null;

let productos = [];
if (q.length >= 2) {
  const { data, error } = await pub.rpc("super_buscar", { p_municipio_id: muni, p_q: q, p_limite: 60 });
  if (error) console.error("super_buscar", error);
  productos = data || [];
} else if (actual) {
  const { data } = await pub.from("super_productos")
    .select("id, nombre, marca, presentacion, foto_url, precio")
    .eq("municipio_id", muni).eq("pasillo_id", actual.id).order("nombre");
  productos = data || [];
}
const h = horarioSuper(horario?.valor);
---
<Base titulo="Lokl Súper" descripcion="Lokl Súper: haz el mercado desde el teléfono y te llega a tu puerta en San Fernando de Apure. Envío gratis desde $20 en el casco central.">
  <main class="contenedor">
    <Cabecera />
    {!pasillos.length ? (
      <>
        <section class="tarjeta bloque" style="text-align:center;margin-top:24px;padding:28px 18px">
          <span style="color:var(--marca)"><Icono nombre="super" tam={56} /></span>
          <h1 style="font-size:26px;margin:10px 0 4px">Lokl Súper</h1>
          <p class="etiqueta-estado" style="margin:0 0 12px;font-size:16px">Muy pronto</p>
          <p style="margin:0">Estamos preparando el supermercado de Lokl: haces tu pedido desde el teléfono y te llega a tu puerta.</p>
        </section>
        <div class="pila-botones" style="margin-top:18px"><a class="boton boton-claro ancho" href="/">Volver al inicio</a></div>
      </>
    ) : (
      <>
        <div class="fila-entre" style="margin-top:14px;align-items:flex-start">
          <div>
            <h1 style="font-size:26px;margin:0">Lokl Súper</h1>
            <span class:list={["estado-super", h.abierto ? "abierto" : "cerrado"]}>{h.texto}</span>
          </div>
          <a href="/super/mis-pedidos" class="boton-texto" style="white-space:nowrap">Mis pedidos</a>
        </div>
        {!h.abierto && <p class="texto-2" style="margin:4px 0 0;font-size:14px">Puedes hacer tu pedido igual: lo atendemos mañana a primera hora.</p>}
        <CatalogoSuper productos={productos} pasillos={pasillos} actual={actual?.slug} q={q} base="/super" tasa={cfg.tasa} envio={cfg.envio} carrito />
      </>
    )}
  </main>
</Base>
