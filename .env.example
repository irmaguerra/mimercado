# Copia este archivo como .env y llena los valores del proyecto Supabase NUEVO.
# En Vercel van en Settings → Environment Variables (solo "Preview" mientras dure el rediseño).
# Las que empiezan con PUBLIC_ pueden llegar al navegador: nunca pongas aquí la service_role key.

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Dirección pública de la app (para enlaces y vista previa de WhatsApp)
PUBLIC_APP_URL=https://usalokl.com

# "Continuar con Google": poner "si" solo después de activarlo en Supabase → Authentication → Providers → Google
PUBLIC_LOGIN_GOOGLE=no
